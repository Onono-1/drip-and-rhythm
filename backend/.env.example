DJANGO_SECRET_KEY=replace-with-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://drip_app:REPLACE_WITH_LOCAL_APP_PASSWORD@127.0.0.1:5432/drip_and_rhythm
TEST_DATABASE_URL=postgresql://drip_test:REPLACE_WITH_LOCAL_TEST_PASSWORD@127.0.0.1:5432/drip_and_rhythm_test
APP_BASE_URL=http://localhost:3000
DJANGO_TIME_ZONE=Africa/Kampala
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64-fernet-key
CLAIM_RECEIPT_TTL_DAYS=

# Email delivery: set EMAIL_DELIVERY_MODE=local for local file+console preview, or resend for live Resend API
EMAIL_DELIVERY_MODE=local
RESEND_API_KEY=
RESEND_FROM_EMAIL=invitations@example.com
RESEND_FROM_NAME=DRIP & RHYTHM
RESEND_REPLY_TO_EMAIL=support@example.com
RESEND_WEBHOOK_SECRET=
EMAIL_MAX_RETRIES=5
EMAIL_WORKER_POLL_INTERVAL=3
EMAIL_WORKER_LEASE_SECONDS=120
